# Copy this file to .env and fill in your own values.
APP_NAME=Fetan Spare Parts
DEBUG=True
USE_SQLITE=True
CREATE_DEFAULT_ADMIN=True
ALLOWED_HOSTS=localhost,127.0.0.1
LAN_IP=127.0.0.1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Render / production deployment values
# Set USE_SQLITE=False and either DATABASE_URL or POSTGRES_* when deploying to Render.
DATABASE_URL=postgresql://erp_user:change-me@your-postgres-host.example.com:5432/erp_saas
POSTGRES_HOST=your-postgres-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=erp_saas
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-me
RENDER_EXTERNAL_HOSTNAME=your-render-app.onrender.com
PORT=8000
